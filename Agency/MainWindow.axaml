<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Agency.MainWindow"
        Title="Agency">
    <Grid RowDefinitions="Auto,*"
          Background="#F5F6FA">

        <!-- Верхняя часть -->
        <Border Grid.Row="0"
                Background="#2F5597"
                Padding="30">

            <StackPanel>
                <TextBlock Text="Система кадрового агентства"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Главное меню"
                           FontSize="16"
                           Foreground="#DDE6F5"
                           Margin="0,5,0,0"/>
            </StackPanel>

        </Border>

        <!-- Главное меню -->
        <Grid Grid.Row="1"
              Margin="40"
              ColumnDefinitions="*,*"
              RowDefinitions="*,*"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <!-- Вакансии -->
            <Button Grid.Row="0"
                    Grid.Column="0"
                    Width="330"
                    Height="150"
                    Margin="10"
                    Background="#DCE6F2"
                    Foreground="Black"
                    BorderBrush="#8FAADC"
                    BorderThickness="2"
                    Click="VacanciesButton_Click">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="ВАКАНСИИ"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Просмотр и добавление вакансий"
                               FontSize="14"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Button>


            <!-- Кандидаты -->
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Width="330"
                    Height="150"
                    Margin="10"
                    Background="#DCE6F2"
                    Foreground="Black"
                    BorderBrush="#8FAADC"
                    BorderThickness="2"
                    Click="CandidatesButton_Click">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="КАНДИДАТЫ"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Список кандидатов"
                               FontSize="14"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Button>


            <!-- Собеседования -->
            <Button Grid.Row="1"
                    Grid.Column="0"
                    Width="330"
                    Height="150"
                    Margin="10"
                    Background="#DCE6F2"
                    Foreground="Black"
                    BorderBrush="#8FAADC"
                    BorderThickness="2"
                    Click="InterviewsButton_Click">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="СОБЕСЕДОВАНИЯ"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Дата и время собеседований"
                               FontSize="14"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Button>


            <!-- Трудоустройство -->
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Width="330"
                    Height="150"
                    Margin="10"
                    Background="#DCE6F2"
                    Foreground="Black"
                    BorderBrush="#8FAADC"
                    BorderThickness="2"
                    Click="EmploymentButton_Click">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="ТРУДОУСТРОЙСТВО"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Информация о трудоустройстве"
                               FontSize="14"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Button>

        </Grid>

    </Grid>
</Window>
